# API (PROD / target del proxy Vite en DEV)
# En DEV el FE usa origen '' + proxy `/api` (ver src/services/api/apiClient.ts).
# Fase 1: flujo = cotizaciones; crédito no montado en FE (ADR_001_frontend_phase1).
VITE_API_URL=http://localhost:8000

# EmailJS (completar con credenciales reales)
# typo en código: también se menciona VITE_EMAILJS_PUBLIC_KEY
VITE_EMAILJS_PUBLIC_KEI=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Cloudinary (completar con credenciales reales)
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_CLOUD_NAME=

# App / debug
VITE_DEBUG_MODE=true
VITE_OBFUSCATION_METHOD=custom
VITE_OBFUSCATION_SALT=grupodrozainka_2024_salt
VITE_NODE_ENV=development
